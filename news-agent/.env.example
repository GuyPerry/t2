# ── Breaking News Agent — Environment Variables ────────────────────────────────

# URL of the CAP news service (change port if needed)
NEWS_SERVICE_URL=http://localhost:4004/api

# OpenAI API key for AI-powered story ranking
# Get one from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use (gpt-4o-mini is fast and cost-effective)
OPENAI_MODEL=gpt-4o-mini

# How many top stories to select per hourly run
TOP_N=3
