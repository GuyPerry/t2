{
  "name": "news-service",
  "version": "1.0.0",
  "description": "Breaking Science & Tech News — CAP Backend Service",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cd ui && npm install && npm run build && cd ..",
    "deploy:sqlite": "npx cds deploy --to sqlite --no-save"
  },
  "dependencies": {
    "@sap/cds": "^7",
    "@cap-js/sqlite": "^1",
    "express": "^4",
    "cors": "^2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^7"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": "news.db" }
      },
      "auth": { "kind": "dummy" }
    }
  }
}
